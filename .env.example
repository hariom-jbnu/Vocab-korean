# Copy this file to .env.local for local development.
# NEVER commit .env files to version control.
#
# Without these the app runs local-only: progress stays in the browser and
# there is no sign-in. On Vercel, set them under Project Settings > Environment
# Variables instead.

# Supabase project URL and publishable key (Project Settings > API Keys).
# On Vercel, the Supabase integration sets NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, which work too.
# The publishable key is safe to ship to the browser; row level security
# keeps each learner's data private. Never put the secret/service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Show "Continue with Google" (turn on the Google provider in Supabase first).
# VITE_GOOGLE_SIGN_IN=true
