# Everything works without this file. Copy it to .env only to change defaults.

# Where the SQLite database and uploaded files live.
DATA_DIR=.data

# Ports: the API server, and the Vite dev server for the website.
API_PORT=8787
WEB_PORT=5173

# Domain used for creator subdomains (ravi.localhost). In production, e.g. vocab.example.com.
BASE_DOMAIN=localhost

# Google sign-in. "mock" uses the local pretend-Google page. "google" is for when a
# real Google adapter is added (see /docs, "Going to production"); until then it falls back to mock.
GOOGLE_PROVIDER=mock
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
